# From your PPI account dashboard (Gestiones -> Gestion de servicio API),
# or the sandbox pair PPI emails you. AuthorizedClient/ClientKey are not
# needed here: the official ppi-client SDK supplies its own for both
# environments internally.
PPI_ENV=sandbox
PPI_API_KEY=
PPI_API_SECRET=
PPI_ACCOUNT_NUMBER=
# Live mode requires both this exact opt-in and the --live CLI flag.
STONKFLY_LIVE=I_ACCEPT_REAL_TRADES
# Optional location of verified MaleCNS files:
# STONKFLY_DATA=data
