# PPI does not publish a fixed base URL in its docs; get it from your PPI
# dashboard/sandbox invitation email, alongside AuthorizedClient/ClientKey.
PPI_BASE_URL=
PPI_API_VERSION=1.0
PPI_AUTHORIZED_CLIENT=
PPI_CLIENT_KEY=
PPI_API_KEY=
PPI_API_SECRET=
PPI_ACCOUNT_NUMBER=
# Live mode requires both this exact opt-in and the --live CLI flag.
STONKFLY_LIVE=I_ACCEPT_REAL_TRADES
# Optional location of verified MaleCNS files:
# STONKFLY_DATA=data
